{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 1,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "installDir": "${sourceDir}/../install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_LIBDIR": "lib"
      }
    },
    {
      "name": "release-cpu",
      "inherits": "base",
      "cacheVariables": {
        "KURT_ENABLED_VENDORS": "cpu",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-cpu",
      "inherits": "base",
      "cacheVariables": {
        "KURT_ENABLED_VENDORS": "cpu",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-cpu-macos-clang",
      "inherits": "release-cpu",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/macos-clang.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "debug-cpu-macos-clang",
      "inherits": "debug-cpu",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/macos-clang.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "release-cpu-linux-clang",
      "inherits": "release-cpu",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/docker-base.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "debug-cpu-linux-clang",
      "inherits": "debug-cpu",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/docker-base.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "release-cuda-linux-clang",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/docker-cuda.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "KURT_ENABLED_VENDORS": "cuda",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_ARCHITECTURES": "80"
      }
    },
    {
      "name": "release-cuda-nvcc",
      "inherits": "release-cuda-linux-clang",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/docker-cuda-nvcc.cmake"
    },
    {
      "name": "release-cpu-windows-msvc",
      "inherits": "release-cpu",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/windows-msvc.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "debug-cpu-windows-msvc",
      "inherits": "debug-cpu",
      "toolchainFile": "${sourceDir}/../cmake/toolchains/windows-msvc.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-cpu",
      "configurePreset": "release-cpu",
      "targets": ["kurt_cpu"],
      "jobs": 64
    },
    {
      "name": "debug-cpu",
      "configurePreset": "debug-cpu",
      "targets": ["kurt_cpu"],
      "jobs": 64
    },
    {
      "name": "release-cpu-macos-clang",
      "inherits": "release-cpu",
      "configurePreset": "release-cpu-macos-clang"
    },
    {
      "name": "debug-cpu-macos-clang",
      "inherits": "debug-cpu",
      "configurePreset": "debug-cpu-macos-clang"
    },
    {
      "name": "release-cpu-linux-clang",
      "inherits": "release-cpu",
      "configurePreset": "release-cpu-linux-clang"
    },
    {
      "name": "debug-cpu-linux-clang",
      "inherits": "debug-cpu",
      "configurePreset": "debug-cpu-linux-clang"
    },
    {
      "name": "release-cuda-linux-clang",
      "configurePreset": "release-cuda-linux-clang",
      "targets": ["kurt_cuda"],
      "jobs": 64
    },
    {
      "name": "release-cuda-nvcc",
      "configurePreset": "release-cuda-nvcc",
      "targets": ["kurt_cuda"],
      "jobs": 64
    },
    {
      "name": "release-cpu-windows-msvc",
      "inherits": "release-cpu",
      "configurePreset": "release-cpu-windows-msvc"
    },
    {
      "name": "debug-cpu-windows-msvc",
      "inherits": "debug-cpu",
      "configurePreset": "debug-cpu-windows-msvc"
    }
  ],
  "workflowPresets": [
    {
      "name": "release-cpu",
      "steps": [
        {"type": "configure", "name": "release-cpu"},
        {"type": "build", "name": "release-cpu"}
      ]
    },
    {
      "name": "debug-cpu",
      "steps": [
        {"type": "configure", "name": "debug-cpu"},
        {"type": "build", "name": "debug-cpu"}
      ]
    },
    {
      "name": "release-cpu-macos-clang",
      "steps": [
        {"type": "configure", "name": "release-cpu-macos-clang"},
        {"type": "build", "name": "release-cpu-macos-clang"}
      ]
    },
    {
      "name": "debug-cpu-macos-clang",
      "steps": [
        {"type": "configure", "name": "debug-cpu-macos-clang"},
        {"type": "build", "name": "debug-cpu-macos-clang"}
      ]
    },
    {
      "name": "release-cpu-linux-clang",
      "steps": [
        {"type": "configure", "name": "release-cpu-linux-clang"},
        {"type": "build", "name": "release-cpu-linux-clang"}
      ]
    },
    {
      "name": "debug-cpu-linux-clang",
      "steps": [
        {"type": "configure", "name": "debug-cpu-linux-clang"},
        {"type": "build", "name": "debug-cpu-linux-clang"}
      ]
    },
    {
      "name": "release-cuda-linux-clang",
      "steps": [
        {"type": "configure", "name": "release-cuda-linux-clang"},
        {"type": "build", "name": "release-cuda-linux-clang"}
      ]
    },
    {
      "name": "release-cuda-nvcc",
      "steps": [
        {"type": "configure", "name": "release-cuda-nvcc"},
        {"type": "build", "name": "release-cuda-nvcc"}
      ]
    },
    {
      "name": "release-cpu-windows-msvc",
      "steps": [
        {"type": "configure", "name": "release-cpu-windows-msvc"},
        {"type": "build", "name": "release-cpu-windows-msvc"}
      ]
    },
    {
      "name": "debug-cpu-windows-msvc",
      "steps": [
        {"type": "configure", "name": "debug-cpu-windows-msvc"},
        {"type": "build", "name": "debug-cpu-windows-msvc"}
      ]
    }
  ]
}
